#include <iostream>
using namespace std;

int main() {
    int s;
    cout << "Enter score: ";
    cin >> s;
    if (s >= 90) cout << "Grade: A" << endl;
    else if (s >= 80) cout << "Grade: B" << endl;
    else if (s >= 70) cout << "Grade: C" << endl;
    else cout << "Grade: Fail" << endl;
    return 0;
}