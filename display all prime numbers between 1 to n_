#include <iostream>
using namespace std;

int main() {
    int n;
    
    cout << "Enter the value of n: ";
    cin >> n;
    
    cout << "Prime numbers between 1 and " << n << " are:\n";
    
    for (int num = 2; num <= n; num++) {
        bool is_prime = true;
        
        for (int i = 2; i <= num / 2; i++) {
            if (num % i == 0) {
                is_prime = false;
                break;
            }
        }
        
        if (is_prime) {
            cout << num << " ";
        }
    }
    
    cout << endl;
    return 0;
}