#include <iostream>
using namespace std;

int main() {
    float x, sum, term;
    int n;

    cout << "Enter x (in radians): ";
    cin >> x;
    cout << "Enter number of terms (n): ";
    cin >> n;

    term = x;
    sum = x;

    for (int i = 1; i < n; i++) {
        term = -term * x * x / ((2 * i) * (2 * i + 1));
        sum = sum + term;
    }

    cout << "Sum = " << sum << endl;
    return 0;
}