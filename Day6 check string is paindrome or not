#include <iostream>
#include <string>
using namespace std;
int main() {
    string s; cin >> s;
    int i = 0, j = s.length() - 1;
    bool isPal = true;
    while(i < j) {
        if(s[i++] != s[j--]) { isPal = false; break; }
    }
    cout << (isPal ? "Palindrome" : "Not Palindrome");
    return 0;
}