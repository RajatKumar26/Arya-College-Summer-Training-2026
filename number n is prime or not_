#include <iostream>
using namespace std;

int main() {
    int n;
    bool is_prime = true; 
    
    cout << "enter any other value: ";
    cin >> n;
    
    if (n <= 1) {
        is_prime = false;
    } else {
        for (int i = 2; i <= n / 2; i++) {
            if (n % i == 0) {
                is_prime = false; 
                break;          
            }
        }
    }
    
    if (is_prime) {
        cout << n << "value is prime" << endl;
    } else {
        cout << n << "value is not prime" << endl;
    }
    
    return 0;
}