#include <iostream>
#include <climits>
using namespace std;
int main() {
    int n; cin >> n;
    int arr[n];
    for(int i = 0; i < n; i++) cin >> arr[i];
    
    int* ptr = arr;
    int mx = INT_MIN;
    for(int i = 0; i < n; i++) {
        if(*(ptr + i) > mx) mx = *(ptr + i);
    }
    cout << mx;
    return 0;
}