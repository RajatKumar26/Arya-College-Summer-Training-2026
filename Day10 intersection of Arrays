#include <iostream>
#include <set>
using namespace std;
int main() {
    int n, m, val; cin >> n >> m;
    set<int> s1;
    for(int i = 0; i < n; i++) { cin >> val; s1.insert(val); }
    for(int i = 0; i < m; i++) {
        cin >> val;
        if(s1.count(val)) {
            cout << val << " ";
            s1.erase(val); // Duplicate Handling
        }
    }
    return 0;
}